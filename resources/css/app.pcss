@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  html,
  body {
    overflow-x: hidden;
  }

  .prose,
  .rich-content {
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .prose img,
  .rich-content img {
    max-width: 100%;
    height: auto;
  }

  .prose video,
  .rich-content video {
    max-width: 100%;
    height: auto;
  }

  .prose iframe,
  .rich-content iframe {
    width: 100%;
    max-width: 100%;
    aspect-ratio: 16 / 9;
    height: auto;
  }

  .prose table,
  .rich-content table {
    display: block;
    width: max-content;
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .prose pre,
  .rich-content pre {
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
}

@layer components {
  .rich-content .ql-align-center {
    text-align: center;
  }

  .rich-content .ql-align-right {
    text-align: right;
  }

  .rich-content .ql-align-justify {
    text-align: justify;
    text-justify: inter-word;
  }

  .rich-content ul {
    list-style: disc;
    padding-left: 1.5rem;
  }

  .rich-content ol {
    list-style: decimal;
    padding-left: 1.5rem;
  }

  .rich-content a {
    text-decoration-line: underline;
    text-underline-offset: 2px;
  }

  .rich-content blockquote {
    border-left: 4px solid rgb(226 232 240);
    padding-left: 1rem;
  }
}

/* Modern Keyframe Animations */
@keyframes marquee {
  0% {
    transform: translateX(0%);
  }
  100% {
    transform: translateX(-50%);
  }
}

@keyframes marquee-reverse {
  0% {
    transform: translateX(-50%);
  }
  100% {
    transform: translateX(0%);
  }
}

@keyframes float-slow {
  0%, 100% {
    transform: translateY(0px);
  }
  50% {
    transform: translateY(-8px);
  }
}

@keyframes pulse-subtle {
  0%, 100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.85;
    transform: scale(1.03);
  }
}

.animate-marquee {
  display: flex;
  width: max-content;
  animation: marquee 35s linear infinite;
}

.animate-marquee:hover {
  animation-play-state: paused;
}

.animate-float {
  animation: float-slow 4s ease-in-out infinite;
}

.animate-pulse-subtle {
  animation: pulse-subtle 3s ease-in-out infinite;
}

/* Inertia Page Transitions */
.page-fade-enter-active,
.page-fade-leave-active {
  transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1), transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.page-fade-enter-from {
  opacity: 0;
  transform: translateY(8px);
}

.page-fade-leave-to {
  opacity: 0;
  transform: translateY(-8px);
}

